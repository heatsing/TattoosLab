# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# Database (Supabase Postgres + Prisma)
# If your Vercel project is linked to Supabase, these names match the
# environment variables injected by the Vercel integration.
# POSTGRES_PRISMA_URL:
#   Runtime connection for Prisma Client / Next.js.
#   Use Supavisor transaction mode on port 6543 with pgbouncer=true.
# POSTGRES_URL_NON_POOLING:
#   Migration / Prisma CLI connection.
#   Prefer the non-pooling 5432 connection.
# ============================================
POSTGRES_PRISMA_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ============================================
# NestJS Auth API
# ============================================
API_PORT=4000
NEST_ALLOWED_ORIGINS=http://localhost:3000
API_JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
API_JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
API_JWT_ACCESS_TTL=15m
API_JWT_REFRESH_TTL=30d

# ============================================
# Authentication (Auth0)
# Create a Regular Web Application in Auth0.
# ============================================
NEXT_PUBLIC_AUTH0_ENABLED=true
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=replace-with-a-32-byte-hex-secret
APP_BASE_URL=http://localhost:3000
AUTH0_MANAGEMENT_API_URL=https://your-tenant.us.auth0.com/api/v2/users
AUTH0_MANAGEMENT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
# Recommended: use a dedicated Machine-to-Machine application.
# Falls back to AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET if these are omitted.
AUTH0_MANAGEMENT_CLIENT_ID=your-auth0-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-auth0-management-client-secret

# ============================================
# Payments (Stripe)
# Get from: https://dashboard.stripe.com
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Product IDs (optional but recommended for dashboard/webhook parity)
STRIPE_PRO_PRODUCT_ID=prod_...
STRIPE_STUDIO_PRODUCT_ID=prod_...

# Price IDs (create in Stripe Dashboard)
STRIPE_PRO_PRICE_MONTHLY=price_...
STRIPE_PRO_PRICE_YEARLY=price_...
STRIPE_STUDIO_PRICE_MONTHLY=price_...
STRIPE_STUDIO_PRICE_YEARLY=price_...
STRIPE_CREDIT_PACK_50_PRICE_ID=price_...
STRIPE_CREDIT_PACK_120_PRICE_ID=price_...

# PayPal
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=paypal-client-id
PAYPAL_CLIENT_SECRET=paypal-client-secret
PAYPAL_WEBHOOK_ID=wh_...
PAYPAL_PRO_PLAN_MONTHLY_ID=P-...
PAYPAL_PRO_PLAN_YEARLY_ID=P-...
PAYPAL_STUDIO_PLAN_MONTHLY_ID=P-...
PAYPAL_STUDIO_PLAN_YEARLY_ID=P-...

# ============================================
# AI Providers
# ============================================
# OpenAI (DALL-E)
OPENAI_API_KEY=sk-...

# Optional: Other AI providers
# REPLICATE_API_TOKEN=r8_...
# STABILITY_API_KEY=sk-...

# ============================================
# Storage (Cloudinary)
# Get from: https://cloudinary.com/console
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com
# SENTRY_DSN=https://...
